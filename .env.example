# =============================================================================
# ORVIX Environment Configuration Template
# Copy this file to '.env' and adjust credentials for local development.
# =============================================================================

# Server Configuration
PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orvix
DB_USER=orvix_user
DB_PASSWORD=orvix_secure_pass_2026
DB_SSLMODE=disable

# Database Startup Behavior
# Set to 'true' to fail server startup immediately if PostgreSQL is unreachable.
DB_REQUIRED=false

# Database Connection Pool Settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300s
DB_CONN_MAX_IDLE_TIME=60s
DB_CONNECT_TIMEOUT=5s
